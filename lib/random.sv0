/* module::random — deterministic, seedable pseudo-random generator for
 * tests and simulation. NOT cryptographically secure: the state is the
 * whole output, so one value reveals every later one. Do not use it for
 * keys, nonces, or anything an attacker could exploit.
 *
 * The generator is a 64-bit linear congruential generator with Knuth's
 * MMIX constants. It is a pure function of the state passed in (no OS
 * entropy, no clock, no hidden globals), so a checked-in seed reproduces
 * the same sequence on every backend (TEST-004).
 */
module random;

use arith::add_wrapping_u64;
use arith::mul_wrapping_u64;

/* Advances the generator: the returned value is both the next state and
 * the next raw 64-bit output. Wraps modulo 2^64. Full period (2^64). The
 * low bits of an LCG are weak, so derive floats from the HIGH bits
 * (`unit_f64` does). */
fn next_u64(state: u64) -> u64 {
    let a: u64 = 6364136223846793005;
    let c: u64 = 1442695040888963407;
    return add_wrapping_u64(mul_wrapping_u64(state, a), c);
}

/* Maps a raw u64 state to an f64 in [0.0, 1.0). Uses the top 53 bits
 * (`state / 2^11`, exact integer division), which convert to f64 exactly,
 * then scales by 2^-53 (a power of two, so exact). The result is always
 * strictly below 1.0; the largest value is 1.0 - 2^-53. Dividing the full
 * u64 by 2^64 - 1 instead would round the highest states to exactly 1.0. */
fn unit_f64(state: u64) -> f64
    ensures(result >= 0.0 && result < 1.0)
{
    let top: u64 = state / 2048;
    let t: f64 = top;
    return t / 9007199254740992.0;
}
