/* module::complex — Complex struct, componentwise/multiplicative
 * arithmetic, modulus/argument, conjugate, polar interoperability.
 * Spec: sv0-mathlib SPEC.md Section 18 (CPLX-001..006; CPLX-007 is
 * Future, gated on TRIG accuracy budgets this library hasn't formally
 * audited — not implemented here).
 *
 * NOTE (toolchain gap, recorded in README.md "Deviations from
 * SPEC.md"): `module math::complex;` is rejected (dotted module paths);
 * this file is `module complex;`.
 *
 * DEVIATION 1 (operator overloading): CPLX-002/CPLX-003 specify
 * `impl Add for Complex`/`impl Sub for Complex`/`impl Neg for
 * Complex`/`impl Mul for Complex`/`impl Div for Complex`, so `a + b`
 * desugars to the trait method per `keywords/reference.md` §2.1. This
 * compiler slice does not parse `impl <Trait> for <Type>` AT ALL —
 * confirmed empirically (`error[E0100]: syntax error` on the bare
 * `impl Add for T {...}` shape, not merely an unimplemented desugaring)
 * before writing this file — matching an already-recorded gap from
 * earlier in this project's toolchain audit (sv0doc documents the
 * desugaring; sv0c's parser/checker don't implement it). Every operator
 * below is instead a plain named free function (`add_complex`,
 * `sub_complex`, `neg_complex`, `mul_complex`, `div_complex`) — same
 * operations, called as `add_complex(a, b)` rather than `a + b`.
 *
 * DEVIATION 2 (Option<Complex> can't be constructed): CPLX-003's
 * `div_checked` is specified as returning `Option<Complex>`. Beyond
 * BUGS.md #9 (the shared generic `Option<T>` doesn't monomorphize —
 * this library's usual workaround is a concrete companion enum, e.g.
 * `OptionI64`), a STRUCT payload hits a deeper wall: an enum's payload
 * "slot" in this compiler is always a single scalar C word
 * (`int`/`int64_t`/`double`/...; see `emit_enum_td`'s slot-category
 * scheme) — there is no slot category for "a whole struct," so even a
 * concrete `enum OptionComplex { Some(Complex), None }` fails at the C
 * level (`error: assigning to 'int' from incompatible type 'Complex'`,
 * confirmed empirically before writing this file). `div_checked_complex`
 * instead returns a `ComplexResult { ok: bool, re: f64, im: f64 }`
 * struct directly — the same "no panic on runtime-unknown input"
 * behavior AD-005 wants, without needing an enum payload to hold a
 * struct at all.
 */
module complex;

use polar::Polar;
use trig::hypot_f64;
use trig::atan2_f64;
use trig::sin_f64;
use trig::cos_f64;
use trig::exp_f64;
use trig::ln_f64;
use arith::abs_f64;

/* CPLX-001: matches `sv0doc/type-system/rules.md` §2.4's worked example
 * exactly (`pub re: f64, pub im: f64`, `Copy` auto-derived) — this
 * compiler slice has no `pub` field-visibility syntax to spell out (a
 * separate, already-documented gap elsewhere in this project), so the
 * fields are plain, unqualified `f64`s, structurally identical
 * otherwise.
 */
struct Complex { re: f64, im: f64 }

/* ── CPLX-002: componentwise arithmetic ──────────────────────────────
 * See this file's DEVIATION 1 above for why these are free functions,
 * not `impl Add`/`impl Sub`/`impl Neg for Complex`.
 */
fn add_complex(a: Complex, b: Complex) -> Complex
    ensures(result.re == a.re + b.re && result.im == a.im + b.im)
{
    return Complex { re: a.re + b.re, im: a.im + b.im };
}

fn sub_complex(a: Complex, b: Complex) -> Complex
    ensures(result.re == a.re - b.re && result.im == a.im - b.im)
{
    return Complex { re: a.re - b.re, im: a.im - b.im };
}

fn neg_complex(a: Complex) -> Complex
    ensures(result.re == (0.0 - a.re) && result.im == (0.0 - a.im))
{
    return Complex { re: 0.0 - a.re, im: 0.0 - a.im };
}

/* ── CPLX-003: multiplication/division ────────────────────────────────
 * `mul_complex` is the standard `(ac - bd, ad + bc)` form, per
 * CPLX-003's own wording. `div_complex` uses Smith's algorithm (the
 * conjugate-multiplication form, scaled by whichever of `b.re`/`b.im`
 * is larger in magnitude) rather than the naive
 * `(a*conj(b)) / (b.re^2 + b.im^2)` — the naive form squares BOTH
 * components of `b` unconditionally, which overflows for any `b` whose
 * magnitude exceeds roughly `sqrt(f64::MAX)`, exactly the same
 * overflow shape `hypot_f64` (TRIG-007) avoids and CPLX-003 explicitly
 * cites as the rationale to mirror.
 */
fn mul_complex(a: Complex, b: Complex) -> Complex {
    let are: f64 = a.re;
    let aim: f64 = a.im;
    let bre: f64 = b.re;
    let bim: f64 = b.im;
    return Complex { re: are * bre - aim * bim, im: are * bim + aim * bre };
}

fn div_complex(a: Complex, b: Complex) -> Complex
    requires(b.re != 0.0 || b.im != 0.0)
{
    let are: f64 = a.re;
    let aim: f64 = a.im;
    let bre: f64 = b.re;
    let bim: f64 = b.im;
    if abs_f64(bre) >= abs_f64(bim) {
        let r: f64 = bim / bre;
        let denom: f64 = bre + bim * r;
        return Complex { re: (are + aim * r) / denom, im: (aim - are * r) / denom };
    }
    let r2: f64 = bre / bim;
    let denom2: f64 = bre * r2 + bim;
    return Complex { re: (are * r2 + aim) / denom2, im: (aim * r2 - are) / denom2 };
}

/* See this file's DEVIATION 2 above for why this returns a plain
 * struct instead of `Option<Complex>`.
 */
struct ComplexResult { ok: bool, re: f64, im: f64 }

fn div_checked_complex(a: Complex, b: Complex) -> ComplexResult {
    if b.re == 0.0 {
        if b.im == 0.0 {
            return ComplexResult { ok: false, re: 0.0, im: 0.0 };
        }
    }
    let r: Complex = div_complex(a, b);
    return ComplexResult { ok: true, re: r.re, im: r.im };
}

/* ── CPLX-004: modulus/argument ──────────────────────────────────────
 * Both reuse `math::trig` directly, per CPLX-004's own wording —
 * `argument` at the origin is `0.0`, matching `atan2_f64(0.0, 0.0)`'s
 * own pinned behavior (TRIG-004) automatically, with no special case
 * needed here.
 */
fn modulus(c: Complex) -> f64
    ensures(result >= 0.0)
{
    return hypot_f64(c.re, c.im);
}

fn argument(c: Complex) -> f64 {
    return atan2_f64(c.im, c.re);
}

/* ── CPLX-005: conjugate + polar interop ─────────────────────────────
 * `to_polar_complex`/`from_polar_complex` interoperate with
 * `math::polar`'s own `Polar` struct (POLAR-001) rather than
 * duplicating it, per CPLX-005's own wording.
 */
fn conjugate(c: Complex) -> Complex
    ensures(result.re == c.re && result.im == (0.0 - c.im))
{
    return Complex { re: c.re, im: 0.0 - c.im };
}

fn to_polar_complex(c: Complex) -> Polar {
    return Polar { r: modulus(c), theta: argument(c) };
}

fn from_polar_complex(p: Polar) -> Complex {
    return Complex { re: p.r * cos_f64(p.theta), im: p.r * sin_f64(p.theta) };
}

/* ── CPLX-006: approximate equality ───────────────────────────────────
 * The documented comparison for computed `Complex` values — never a
 * bare `==` on the struct itself (this compiler slice has no derived
 * structural `Eq` for structs to even fall back on, so there is nothing
 * to guard against accidentally reaching for here beyond the discipline
 * CPLX-006 itself asks for).
 */
fn approx_eq(a: Complex, b: Complex, epsilon: f64) -> bool
    ensures(result == (abs_f64(a.re - b.re) <= epsilon && abs_f64(a.im - b.im) <= epsilon))
{
    return abs_f64(a.re - b.re) <= epsilon && abs_f64(a.im - b.im) <= epsilon;
}

/* ── CPLX-007: complex exponential form ──────────────────────────────
 * Gated on `math::trig`'s `sin_f64`/`cos_f64`/`exp_f64`/`ln_f64` all
 * meeting PERF-002's accuracy budgets first (Section 15) — see
 * `docs/accuracy.md`: all four now pass, so this is implemented rather
 * than left "Future".
 *
 * `exp_complex(c) = exp(c.re) * (cos(c.im) + i*sin(c.im))` — the
 * standard Euler's-formula expansion, reusing `exp_f64`/`cos_f64`/
 * `sin_f64` directly.
 */
fn exp_complex(c: Complex) -> Complex {
    let mag: f64 = exp_f64(c.re);
    return Complex { re: mag * cos_f64(c.im), im: mag * sin_f64(c.im) };
}

/* `ln_complex(c) = ln(|c|) + i*arg(c)` for `c != 0` — undefined (a branch
 * point) at the origin, per the standard complex logarithm's own domain;
 * `requires` excludes it the same way `div_complex` excludes `b == 0`.
 */
fn ln_complex(c: Complex) -> Complex
    requires(c.re != 0.0 || c.im != 0.0)
{
    return Complex { re: ln_f64(modulus(c)), im: argument(c) };
}

/* `pow_complex(base, exp) = exp(exp * ln(base))` — the standard complex
 * power identity, built directly on `exp_complex`/`ln_complex`/
 * `mul_complex` above; inherits `ln_complex`'s own `requires` (`base`
 * away from the origin) since it's the only partial step in the chain.
 */
fn pow_complex(base: Complex, exp: Complex) -> Complex
    requires(base.re != 0.0 || base.im != 0.0)
{
    return exp_complex(mul_complex(exp, ln_complex(base)));
}
