/* module::arith — absolute value, sign, min/max/clamp, rounding, integer
 * power, checked/wrapping/saturating arithmetic, interpolation, FMA.
 * Spec: sv0-mathlib SPEC.md Section 11 (ARITH-001..010).
 *
 * NOTE (toolchain gap, recorded in README.md "Deviations from SPEC.md"):
 * `module math::arith;` (a dotted module path) is rejected by the current
 * compiler ("E0320: module path must be a single identifier in this
 * slice"), so this file is `module arith;`, not `module math::arith;`.
 * Consumers write `use arith::abs_i32;`, not `use math::arith::abs_i32;`.
 *
 * f64 forms (abs_f64, sign_f64, min_f64, max_f64, clamp_f64) are now
 * implemented too — BUGS.md #5 (the native compiler silently miscompiling
 * f64 as `int`) is fixed upstream as of sv0-toolchain commit
 * (see BUGS.md for the fix commit once landed). Verified by inspecting the
 * emitted C for `double` end to end (params, locals, temps, call results),
 * not just exit codes — see BUGS.md #5's verification note.
 *
 * C-backend only for now: the VM backend (`vm-project-compile`) still
 * cannot type-check a non-i32/bool contract at all (BUGS.md #2, a separate,
 * lower-priority, not-yet-fixed bug) — `abs_f64`'s `ensures(result >= 0.0)`
 * fails to compile there. COMPAT-001/002 VM parity remains blocked on #2.
 *
 * abs_checked_i32 (ARITH-001's Option-returning companion) is implemented
 * too — BUGS.md #3 (generic enums like `Option<T>` failing to resolve) is
 * fixed upstream.
 *
 * abs_i64/sign_i64 are implemented too — BUGS.md #1 (integer literals wider
 * than i32 truncating) is fixed upstream. abs_checked_i64 is still blocked,
 * by a different, newly-found gap (BUGS.md #8: enum payload slots are
 * always a 32-bit C `int` regardless of the payload's real type).
 */
module arith;

use prelude::Option;
use prelude::OptionI64;

/* Absolute value of a signed i32.
 *
 * Domain: all i32 except i32::MIN, whose absolute value (2147483648) is not
 * representable in i32. Callers that cannot statically rule out i32::MIN
 * should use abs_checked_i32 instead.
 */
fn abs_i32(x: i32) -> i32
    requires(x != (0 - 2147483648))
    ensures(result >= 0)
{
    if x < 0 {
        return 0 - x;
    }
    return x;
}

/* Checked absolute value: None only at i32::MIN, where abs_i32 would
 * violate its own requires clause.
 */
fn abs_checked_i32(x: i32) -> Option {
    if x == (0 - 2147483648) {
        return Option::None;
    }
    return Option::Some(abs_i32(x));
}

/* Absolute value of an f64. Total function: NaN and Infinity both have a
 * well-defined IEEE-754 absolute value, so there is no requires clause. */
fn abs_f64(x: f64) -> f64
    ensures(result >= 0.0)
{
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

/* Absolute value of a signed i64 — BUGS.md #1 is fixed upstream. */
fn abs_i64(x: i64) -> i64
    requires(x != (0 - 9223372036854775807 - 1))
    ensures(result >= 0)
{
    if x < 0 {
        return 0 - x;
    }
    return x;
}

/* Checked absolute value for i64: None only at i64::MIN, where abs_i64
 * would violate its own requires clause. BUGS.md #8 (enum payload slots
 * always a 32-bit `int`) is fixed upstream, but returns OptionI64, a
 * concrete companion to the shared prelude::Option<T> — NOT Option<i64> —
 * because sv0 generics resolve without monomorphizing (BUGS.md #9): the
 * shared Option<T>'s payload slot type is textually "T" at its
 * declaration, never a concrete type, so bug #8's per-slot-category
 * resolution has nothing to key off for the generic case. See BUGS.md #9
 * and README.md's "Deviations from SPEC.md".
 */
fn abs_checked_i64(x: i64) -> OptionI64 {
    if x == (0 - 9223372036854775807 - 1) {
        return OptionI64::None;
    }
    return OptionI64::Some(abs_i64(x));
}

/* Sign of a signed i32: -1, 0, or 1. Total function. */
fn sign_i32(x: i32) -> i32
    ensures(result == (0 - 1) || result == 0 || result == 1)
{
    if x < 0 {
        return 0 - 1;
    }
    if x > 0 {
        return 1;
    }
    return 0;
}

/* Sign of a signed i64: -1, 0, or 1. Total function. */
fn sign_i64(x: i64) -> i64
    ensures(result == (0 - 1) || result == 0 || result == 1)
{
    if x < 0 {
        return 0 - 1;
    }
    if x > 0 {
        return 1;
    }
    return 0;
}

/* Sign of an f64: -1.0, 0.0, or 1.0. Total function; ARITH-002 pins NaN to
 * 0.0 explicitly (documented and tested, not left as an unspecified case
 * per CONV-005(b)). */
fn sign_f64(x: f64) -> f64
    ensures(result == (0.0 - 1.0) || result == 0.0 || result == 1.0)
{
    if x != x {
        return 0.0;
    }
    if x < 0.0 {
        return 0.0 - 1.0;
    }
    if x > 0.0 {
        return 1.0;
    }
    return 0.0;
}

/* Smaller of two i32s. Ties return b. */
fn min_i32(a: i32, b: i32) -> i32
    ensures(result == a || result == b)
    ensures(result <= a && result <= b)
{
    if a < b {
        return a;
    }
    return b;
}

/* Larger of two i32s. Ties return b. */
fn max_i32(a: i32, b: i32) -> i32
    ensures(result == a || result == b)
    ensures(result >= a && result >= b)
{
    if a > b {
        return a;
    }
    return b;
}

/* Clamp x into [lo, hi]. */
fn clamp_i32(x: i32, lo: i32, hi: i32) -> i32
    requires(lo <= hi)
    ensures(result >= lo && result <= hi)
    ensures(!(lo <= x && x <= hi) || result == x)
{
    return min_i32(max_i32(x, lo), hi);
}

/* Smaller of two f64s, propagating NaN: if either operand is NaN, that NaN
 * is returned (checked explicitly, not left to fall out of `<` — every NaN
 * comparison is false, so a naive `if a < b { a } else { b }` would return
 * b whenever EITHER operand is NaN, silently discarding a NaN a). The
 * ordering ensures below only needs to hold on the non-NaN domain — the
 * `|| result != result` disjunct is this function's documented,
 * CONV-005(b)-style exception for the propagated-NaN case, not a weaker
 * contract.
 */
fn min_f64(a: f64, b: f64) -> f64
    ensures(result == a || result == b)
    ensures((result <= a && result <= b) || result != result)
{
    if a != a {
        return a;
    }
    if b != b {
        return b;
    }
    if a < b {
        return a;
    }
    return b;
}

/* Larger of two f64s, propagating NaN symmetrically — see min_f64. */
fn max_f64(a: f64, b: f64) -> f64
    ensures(result == a || result == b)
    ensures((result >= a && result >= b) || result != result)
{
    if a != a {
        return a;
    }
    if b != b {
        return b;
    }
    if a > b {
        return a;
    }
    return b;
}

/* Clamp x into [lo, hi]. `requires(lo <= hi)` already rules out NaN lo/hi
 * (every NaN comparison is false, so a NaN operand there fails `lo <= hi`).
 * NaN x is in-domain and propagates through max_f64/min_f64 as they
 * document — hence the same `|| result != result` disjunct as min_f64/
 * max_f64, not present in SPEC.md's literal ARITH-004 wording but required
 * for the ensures to actually hold on NaN x (this is a spec gap, not a
 * toolchain one — this library's own contract wording, not filed in
 * BUGS.md).
 */
fn clamp_f64(x: f64, lo: f64, hi: f64) -> f64
    requires(lo <= hi)
    ensures((result >= lo && result <= hi) || result != result)
    ensures(!(lo <= x && x <= hi) || result == x)
{
    return min_f64(max_f64(x, lo), hi);
}

/* ── ARITH-005: floor/ceil/round/trunc ───────────────────────────────
 *
 * No native cast/libm is available (Tier 1: pure sv0 arithmetic only —
 * see README's Tier 1/Tier 2 section), and an f64->i64 `as` cast was
 * checked and found to route through the SAME "everything defaults to
 * int" codegen category the toolchain bug-hunt kept finding all session
 * (`x as i64` emits `int _sv0tN = (x);` — a 32-bit-int-typed intermediate,
 * silently wrong for any value outside i32's range) — not filed as a
 * tenth BUGS.md entry since nothing in this library's actual functions
 * needs a numeric cast once these are written in pure f64 arithmetic
 * instead, but worth flagging here for whoever implements a `_f64` ->
 * integer conversion function later.
 *
 * `frac_floor_of_nonneg` is the shared primitive: for x >= 0.0 (and,
 * critically, x < 2^52 — see below), it reconstructs floor(x) one bit of
 * the integer part at a time via a bounded (53-iteration) binary search,
 * the same "fixed, documented iteration bound, not a convergence-detecting
 * early exit" shape SPEC.md Section 15 already establishes for
 * `sqrt_f64`'s Newton-Raphson bound. 2^52 (4503599627370496.0) is the
 * threshold above which an IEEE-754 double has no representable
 * fractional part at all — every value at or beyond that magnitude IS
 * already its own floor/ceil/round/trunc, so all four public functions
 * below short-circuit to identity there (and this also transparently
 * covers +-Infinity, since any comparison against a finite magnitude is
 * true for Infinity by IEEE-754 rule — no separate is_infinite_f64 check
 * needed). NaN and +-0.0 both short-circuit to identity too: returning
 * the ORIGINAL `x` (not a freshly-constructed 0.0/NaN) is what preserves
 * -0.0's sign and NaN's payload bits, matching ARITH-005's own boundary
 * fixture list (`0.0`, `-0.0` are both explicitly required cases).
 */
fn frac_floor_of_nonneg(x: f64) -> f64
    requires(x >= 0.0)
    ensures(result <= x)
    ensures(result > x - 1.0 || result == x)
{
    let mut acc: f64 = 0.0;
    let mut bit: f64 = 4503599627370496.0;
    /* loop_invariant: acc <= x always holds (acc only ever grows by a
     * candidate already checked <= x), and `bit` is always an exact,
     * strictly-halving power of two. Terminates in exactly 53 iterations
     * (bit halves from 2^52 down past 1.0), a fixed bound independent of
     * x — the same provable-termination shape SQRT_ITERATION_BOUND uses. */
    while bit >= 1.0 loop_invariant(acc <= x) {
        let cand: f64 = acc + bit;
        if cand <= x {
            acc = cand;
        }
        bit = bit / 2.0;
    }
    return acc;
}

fn trunc_f64(x: f64) -> f64
    ensures(((x >= 0.0 && result <= x && result > x - 1.0) ||
             (x < 0.0 && result >= x && result < x + 1.0) ||
             result == x) || result != result)
{
    if x != x { return x; }
    if x == 0.0 { return x; }
    if x >= 4503599627370496.0 { return x; }
    if x <= (0.0 - 4503599627370496.0) { return x; }
    if x >= 0.0 { return frac_floor_of_nonneg(x); }
    return 0.0 - frac_floor_of_nonneg(0.0 - x);
}

fn floor_f64(x: f64) -> f64
    ensures((result <= x && result > x - 1.0) || result == x || result != result)
{
    if x != x { return x; }
    if x == 0.0 { return x; }
    if x >= 4503599627370496.0 { return x; }
    if x <= (0.0 - 4503599627370496.0) { return x; }
    if x >= 0.0 { return frac_floor_of_nonneg(x); }
    let t: f64 = trunc_f64(x);
    if t == x { return t; }
    return t - 1.0;
}

fn ceil_f64(x: f64) -> f64
    ensures((result >= x && result < x + 1.0) || result == x || result != result)
{
    if x != x { return x; }
    if x == 0.0 { return x; }
    if x >= 4503599627370496.0 { return x; }
    if x <= (0.0 - 4503599627370496.0) { return x; }
    if x <= 0.0 { return 0.0 - frac_floor_of_nonneg(0.0 - x); }
    let t: f64 = trunc_f64(x);
    if t == x { return t; }
    return t + 1.0;
}

/* round-half-away-from-zero (pinned choice, per ARITH-005's requirement
 * to pin and test one of round-half-to-even / round-half-away-from-zero
 * explicitly): round(2.5) == 3.0, round(-2.5) == -3.0. Implemented as
 * floor(x + 0.5) for x >= 0.0 and its negated mirror for x < 0.0 — exact
 * for every representable x because adding 0.5 to a double is itself
 * always exact (0.5 == 2^-1, representable with a single mantissa bit
 * regardless of x's own exponent), so this never introduces a rounding
 * error the way `(x + BIG) - BIG`-style tricks can. */
fn round_f64(x: f64) -> f64
    ensures(((result - x) >= (0.0 - 0.5) && (result - x) <= 0.5) || result != result)
{
    if x != x { return x; }
    if x == 0.0 { return x; }
    if x >= 4503599627370496.0 { return x; }
    if x <= (0.0 - 4503599627370496.0) { return x; }
    if x >= 0.0 { return frac_floor_of_nonneg(x + 0.5); }
    return 0.0 - frac_floor_of_nonneg((0.0 - x) + 0.5);
}

/* ── ARITH-006: NaN/Infinity classification ──────────────────────────
 * The library's ONLY sanctioned way to test f64 classification (CONV
 * requirement): every other function that needs a NaN check uses
 * `is_nan_f64`, not a bare `x != x`, from this point on in the codebase
 * (existing functions written earlier this session — sign_f64, min_f64,
 * max_f64 — predate this rule and keep their inline `x != x` checks
 * rather than being churned for a naming-only change).
 */
fn is_nan_f64(x: f64) -> bool
    ensures(result == (x != x))
{
    return x != x;
}

fn is_infinite_f64(x: f64) -> bool
    ensures(!result || !is_nan_f64(x))
{
    if x != x { return false; }
    let pos_inf: f64 = 1.0 / 0.0;
    if x == pos_inf { return true; }
    if x == (0.0 - pos_inf) { return true; }
    return false;
}

fn is_finite_f64(x: f64) -> bool
    ensures(result == (!is_nan_f64(x) && !is_infinite_f64(x)))
{
    if x != x { return false; }
    return !is_infinite_f64(x);
}

/* ── ARITH-009: lerp ──────────────────────────────────────────────── */

fn lerp_f64(a: f64, b: f64, t: f64) -> f64
    requires(t >= 0.0 && t <= 1.0)
    ensures(!(t == 0.0) || result == a)
    ensures(!(t == 1.0) || result == b)
{
    return a + t * (b - a);
}
