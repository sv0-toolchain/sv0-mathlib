/* TEST-001 property layer and TEST-004 (fixed seed). One property per file;
 * `ROUNDS` and the seed are pinned by docs/fuzz.tsv (see
 * trig_identity_property.sv0 for the convention). */
use random::next_u64;
use random::unit_f64;
use arith::abs_f64;
use polar::Polar;
use polar::Point2;
use polar::to_polar;
use polar::from_polar;

fn main() -> i32 {
    let ROUNDS: i32 = 30;
    let mut state: u64 = 1442695040888963407;

    /* REQ: POLAR-004 property — to_polar composed with from_polar
     * round-trips, over seeded (x,y) samples including near-origin (the
     * generator's own [0,1) range naturally includes values arbitrarily
     * close to the 0.5 recentering point) and large-magnitude points. */
    let mut j: i32 = 0;
    while j < ROUNDS loop_invariant(j <= ROUNDS) {
        state = next_u64(state);
        let ux: f64 = unit_f64(state);
        state = next_u64(state);
        let uy: f64 = unit_f64(state);
        let x2: f64 = (ux - 0.5) * 2000000.0;
        let y2: f64 = (uy - 0.5) * 2000000.0;
        let p: Polar = to_polar(x2, y2);
        let xy: Point2 = from_polar(p);
        if abs_f64(xy.x - x2) >= 0.0001 { return 2; }
        if abs_f64(xy.y - y2) >= 0.0001 { return 2; }
        j = j + 1;
    }
    return 0;
}
