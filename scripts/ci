#!/usr/bin/env bash
# TEST-006 (R1): a dedicated sv0-mathlib-local CI gate equivalent to
# `sv0-toolchain`'s own `./scripts/sv0 ci`, and .sv0 formatting/lint
# parity with the upstream toolchain (via the SAME upstream scripts,
# not a local copy that could drift).
#
# sv0-mathlib is a submodule of sv0-toolchain (README "Deviations from
# SPEC.md" #2/#10) — the toolchain root is this repo's parent directory.
# The legacy sibling layout (../sv0-toolchain) is still auto-detected, and
# SV0_TOOLCHAIN_ROOT overrides either (sv0-mathlib's own CI sets it).
#
# Usage: scripts/ci [--skip-fmt] [--skip-guard] [--skip-run] [--skip-unit] [--skip-fixtures] [--skip-doc] [--skip-parity] [--skip-fixture-parity] [--skip-ulp] [--skip-vm-determinism] [--skip-unit-vm] [--skip-stats-accuracy]
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "${SV0_TOOLCHAIN_ROOT:-}" ]]; then
  TOOLCHAIN="$SV0_TOOLCHAIN_ROOT"
elif [[ -d "$HERE/../sv0c" && -f "$HERE/../scripts/sv0" ]]; then
  TOOLCHAIN="$HERE/.."                 # submodule of sv0-toolchain
elif [[ -d "$HERE/../sv0-toolchain" ]]; then
  TOOLCHAIN="$HERE/../sv0-toolchain"   # legacy sibling layout
else
  TOOLCHAIN="$HERE/.."
fi
TOOLCHAIN="$(cd "$TOOLCHAIN" && pwd)"

SKIP_FMT=0
SKIP_GUARD=0
SKIP_RUN=0
SKIP_UNIT=0
SKIP_FIXTURES=0
SKIP_DOC=0
SKIP_PARITY=0
SKIP_FIXTURE_PARITY=0
SKIP_ULP=0
SKIP_VM_DETERMINISM=0
SKIP_UNIT_VM=0
SKIP_STATS_ACC=0
for arg in "$@"; do
  case "$arg" in
    --skip-fmt) SKIP_FMT=1 ;;
    --skip-guard) SKIP_GUARD=1 ;;
    --skip-run) SKIP_RUN=1 ;;
    --skip-unit) SKIP_UNIT=1 ;;
    --skip-fixtures) SKIP_FIXTURES=1 ;;
    --skip-doc) SKIP_DOC=1 ;;
    --skip-parity) SKIP_PARITY=1 ;;
    --skip-fixture-parity) SKIP_FIXTURE_PARITY=1 ;;
    --skip-vm-determinism) SKIP_VM_DETERMINISM=1 ;;
    --skip-unit-vm) SKIP_UNIT_VM=1 ;;
    --skip-stats-accuracy) SKIP_STATS_ACC=1 ;;
    --skip-ulp) SKIP_ULP=1 ;;
    *)
      echo "sv0-mathlib ci: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

if [[ ! -d "$TOOLCHAIN" ]]; then
  echo "sv0-mathlib ci: sv0-toolchain not found at $TOOLCHAIN (set SV0_TOOLCHAIN_ROOT)" >&2
  exit 1
fi

FMT_SCRIPT="$TOOLCHAIN/scripts/fmt_sv0.py"
GUARD_SCRIPT="$TOOLCHAIN/scripts/check_sv0_block_comment_nesting.py"
NATIVE_COMPILER="$TOOLCHAIN/build/sv0-megatu-compiler-native"
RUNTIME_DIR="$TOOLCHAIN/sv0c/runtime"

if [[ "$SKIP_FMT" -eq 0 ]]; then
  echo "== sv0-mathlib ci: fmt --check (whitespace parity, TEST-006) =="
  if [[ ! -f "$FMT_SCRIPT" ]]; then
    echo "sv0-mathlib ci: missing $FMT_SCRIPT" >&2
    exit 1
  fi
  python3 "$FMT_SCRIPT" --check "$HERE/lib" "$HERE/main.sv0" "$HERE/test"
  echo "sv0-mathlib ci: fmt --check OK"
fi

if [[ "$SKIP_GUARD" -eq 0 ]]; then
  echo "== sv0-mathlib ci: block-comment nesting guard (TEST-006) =="
  if [[ ! -f "$GUARD_SCRIPT" ]]; then
    echo "sv0-mathlib ci: missing $GUARD_SCRIPT" >&2
    exit 1
  fi
  python3 "$GUARD_SCRIPT" "$HERE/lib" "$HERE"
  echo "sv0-mathlib ci: block-comment nesting guard OK"
fi

if [[ "$SKIP_RUN" -eq 0 ]]; then
  echo "== sv0-mathlib ci: compile + run full project (C backend) =="
  if [[ ! -x "$NATIVE_COMPILER" ]]; then
    echo "sv0-mathlib ci: missing $NATIVE_COMPILER — build sv0-toolchain first" \
      "(e.g. bash \"$TOOLCHAIN/scripts/build-sv0-megatu-native.sh\")" >&2
    exit 1
  fi
  # See feedback_drv_path_reset: reset before any gate/push, this control
  # file is read as a PATH by the (legacy-path) driver, not program text.
  printf '' > /tmp/.sv0_drv_path
  WORK="$(mktemp -d)"
  trap 'rm -rf "$WORK"' EXIT
  "$NATIVE_COMPILER" --project "$HERE" > "$WORK/mathlib.c"
  cc -std=c99 -O0 -w -I "$RUNTIME_DIR" "$WORK/mathlib.c" "$RUNTIME_DIR/sv0_runtime.c" \
    -o "$WORK/mathlib_bin"
  "$WORK/mathlib_bin"
  echo "sv0-mathlib ci: compile + run OK (exit 0)"
fi

if [[ "$SKIP_UNIT" -eq 0 ]]; then
  echo "== sv0-mathlib ci: test/unit/*.sv0 + test/property/*.sv0 + requirement-to-test matrix (TEST-001) =="
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/run_unit_tests.py"
  echo "sv0-mathlib ci: test/unit + test/property + matrix OK"
fi

if [[ "$SKIP_UNIT_VM" -eq 0 && "$SKIP_UNIT" -eq 0 ]]; then
  echo "== sv0-mathlib ci: unit + property tests on the VM backend (C/VM exit-code agreement) =="
  # run_unit_tests.py gates the C backend only; this runs the same programs
  # on sv0vm too, so modules the whole-library parity main never touches
  # (random, stats) are cross-checked. C failures gate; the VM leg is
  # advisory, like run_fixture_parity.py's (BUGS.md). --strict-vm to gate.
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/run_unit_tests_vm.py"
  echo "sv0-mathlib ci: unit tests on VM OK"
fi

if [[ "$SKIP_FIXTURES" -eq 0 ]]; then
  echo "== sv0-mathlib ci: fixture manifest + boundary-coverage lint (TEST-002/TEST-003) =="
  python3 "$HERE/scripts/check_fixtures.py"
  python3 "$HERE/scripts/check_fixture_oracles.py"
  # The exceptions registry (docs/exceptions.tsv) is validated here, and its
  # markdown view regenerated, like docs/api.md. It reads the requirement
  # matrix the unit stage writes, so it stays after that stage.
  python3 "$HERE/scripts/check_exceptions.py" --write-md
  # Fuzz budget: every test/property/*.sv0 fixture is pinned in docs/fuzz.tsv
  # (seed + ROUNDS + floor); docs/fuzz-evidence.md is regenerated from it.
  python3 "$HERE/scripts/check_fuzz_budget.py" --write-md
  echo "sv0-mathlib ci: fixtures OK"
fi

if [[ "$SKIP_DOC" -eq 0 ]]; then
  echo "== sv0-mathlib ci: doc-comment coverage lint (DOC-001) =="
  python3 "$HERE/scripts/check_doc_comments.py"
  echo "sv0-mathlib ci: doc comments OK"
  echo "== sv0-mathlib ci: regenerate docs/api.md =="
  python3 "$HERE/scripts/gen_api_docs.py"
fi

if [[ "$SKIP_PARITY" -eq 0 ]]; then
  echo "== sv0-mathlib ci: cross-backend parity (COMPAT-001/002, TEST-005) =="
  # The native VM backend now compiles + runs this library (sv0-toolchain
  # sv0c-vm-float-parity). vm_behavioral_parity.py runs every fixture in the
  # toolchain's behavioral-manifest.txt -- which includes `--project
  # ../sv0-mathlib`, i.e. THIS checkout -- through both native backends
  # (emit-c -> run and VM-emit -> sv0vm) and compares exit codes. Needs SML/NJ
  # + the sv0vm submodule (the CI workflow bootstraps both).
  PARITY="$TOOLCHAIN/scripts/vm_behavioral_parity.py"
  if [[ ! -f "$PARITY" ]]; then
    echo "sv0-mathlib ci: missing $PARITY (update sv0-toolchain checkout)" >&2
    exit 1
  fi
  python3 "$PARITY"
  echo "sv0-mathlib ci: cross-backend parity OK"
fi

if [[ "$SKIP_FIXTURE_PARITY" -eq 0 ]]; then
  echo "== sv0-mathlib ci: per-fixture value check (COMPAT-002 / TEST-005) =="
  # vm_behavioral_parity.py above compares only the whole-library exit
  # code between backends. run_fixture_parity.py goes row-by-row: it
  # generates one fn main()->i32 from test/fixtures/{rounding,trig,random,stats}.csv
  # (one check per row+function), then compiles+runs it and checks each
  # result against the fixture's own EXPECTED column. The C-backend leg
  # GATES (this is the reproducible form of the one-time manual check the
  # fixture manifest used to describe). The VM-backend leg is ADVISORY:
  # the original Unsafe.cast codec bug it was tracking is fixed upstream
  # in sv0vm, but the failure is still intermittent even with the fix --
  # a separate, still-unconfirmed nondeterminism -- see BUGS.md. Pass
  # --strict-vm to gate on it too. Needs SML/NJ + the sv0vm submodule.
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/run_fixture_parity.py"
  echo "sv0-mathlib ci: per-fixture value check OK"
fi

if [[ "$SKIP_STATS_ACC" -eq 0 ]]; then
  echo "== sv0-mathlib ci: stats accuracy regression gate (exact-rational reference) =="
  # scripts/run_stats_accuracy.py runs the sv0-emitted Stats accumulator on
  # seeded data sets and grades every reduction against an exact rational
  # reference; it fails if any (function, data family) exceeds its budget.
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/run_stats_accuracy.py"
  echo "sv0-mathlib ci: stats accuracy OK"
fi

if [[ "$SKIP_ULP" -eq 0 ]]; then
  echo "== sv0-mathlib ci: ULP accuracy regression gate (PERF-001/PERF-002) =="
  # docs/ulp_audit_harness.c compares every non-exact function against the
  # system libm; run_ulp_audit.py compiles+runs it and fails if anything
  # OUTSIDE the documented informational-residual allowlist (ln_complex,
  # pow_complex -- see docs/accuracy.md) exceeds its printed budget, or if
  # either of those two grows past its recorded ceiling. Needs libm (-lm,
  # always available) -- no SML/NJ or sv0vm dependency.
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/run_ulp_audit.py"
  echo "sv0-mathlib ci: ULP accuracy regression gate OK"
fi

if [[ "$SKIP_VM_DETERMINISM" -eq 0 ]]; then
  echo "== sv0-mathlib ci: VM emitter determinism check (diagnostic, non-gating) =="
  # Investigating the intermittent frac_floor_of_nonneg abort in the
  # per-fixture VM leg above (advisory -- see BUGS.md): re-invokes the
  # native VM emitter N times against the same input and diffs the raw
  # .sv0b bytes, to test the "the emitter's own output is nondeterministic"
  # theory directly against THIS CI runner's real environment. Not yet a
  # gate -- a positive result here (a real mismatch) would be actionable
  # evidence this bug has never had; `|| true` keeps this exploratory
  # step from failing the required gate while that's still being chased.
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/check_vm_emitter_determinism.py" || true

  echo "== sv0-mathlib ci: VM interpreter determinism check (diagnostic, non-gating) =="
  # Complements the emitter check above: builds the per-fixture check
  # program ONCE, holds its .sv0b bytes fixed, and runs sv0vm against
  # that same file repeatedly. If the emitter's output is provably
  # stable (per the check above) but this still disagrees run to run,
  # the remaining source of the intermittent frac_floor_of_nonneg abort
  # is in EXECUTION (sv0vm's interpreter), not emission -- see BUGS.md.
  printf '' > /tmp/.sv0_drv_path
  SV0_TOOLCHAIN_ROOT="$TOOLCHAIN" python3 "$HERE/scripts/check_vm_interpreter_determinism.py" || true
fi

echo "sv0-mathlib ci: PASS"
