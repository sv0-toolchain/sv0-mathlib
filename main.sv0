/* sv0-mathlib smoke/demo entry point.
 * Exit code convention: 0 = pass, nonzero = first failing case index.
 *
 * abs_checked_i32's Option-returning path is NOT exercised here: `Option<T>`
 * cannot be used in a `--project` (multi-file) build today — see BUGS.md #3.
 * It IS exercised, correctly, in a single-file harness — see BUGS.md #3 for
 * the exact repro showing the logic is right and the tooling is the blocker.
 */
use arith::abs_i32;
use arith::abs_f64;

fn main() -> i32 {
    if abs_i32(5) != 5 { return 1; }
    if abs_i32(0 - 5) != 5 { return 2; }
    if abs_i32(0) != 0 { return 3; }

    if abs_f64(5.0) != 5.0 { return 6; }
    if abs_f64(0.0 - 5.0) != 5.0 { return 7; }
    if abs_f64(0.0) != 0.0 { return 8; }

    return 0;
}
