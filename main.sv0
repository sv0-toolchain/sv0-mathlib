/* sv0-mathlib smoke/demo entry point.
 * Exit code convention: 0 = pass, nonzero = first failing case index.
 * Covers ARITH-001..004's i32 and f64 forms — see lib/arith.sv0 and
 * BUGS.md for what's still blocked and why (abs_i64/sign_i64, Option-based
 * _checked companions, VM-backend parity).
 */
use arith::abs_i32;
use arith::abs_f64;
use arith::sign_i32;
use arith::sign_f64;
use arith::min_i32;
use arith::min_f64;
use arith::max_i32;
use arith::max_f64;
use arith::clamp_i32;
use arith::clamp_f64;

fn main() -> i32 {
    if abs_i32(5) != 5 { return 1; }
    if abs_i32(0 - 5) != 5 { return 2; }
    if abs_i32(0) != 0 { return 3; }
    if abs_f64(5.0) != 5.0 { return 4; }
    if abs_f64(0.0 - 5.0) != 5.0 { return 5; }
    if abs_f64(0.5) != 0.5 { return 6; }

    if sign_i32(5) != 1 { return 10; }
    if sign_i32(0 - 5) != (0 - 1) { return 11; }
    if sign_i32(0) != 0 { return 12; }
    if sign_f64(5.0) != 1.0 { return 13; }
    if sign_f64(0.0 - 5.0) != (0.0 - 1.0) { return 14; }
    if sign_f64(0.0) != 0.0 { return 15; }
    let nan: f64 = 0.0 / 0.0;
    if sign_f64(nan) != 0.0 { return 16; }

    if min_i32(3, 7) != 3 { return 20; }
    if min_i32(7, 3) != 3 { return 21; }
    if min_i32(4, 4) != 4 { return 22; }
    if max_i32(3, 7) != 7 { return 23; }
    if max_i32(7, 3) != 7 { return 24; }
    if max_i32(4, 4) != 4 { return 25; }
    if min_f64(3.0, 7.0) != 3.0 { return 26; }
    if min_f64(7.0, 3.0) != 3.0 { return 27; }
    if max_f64(3.0, 7.0) != 7.0 { return 28; }
    if max_f64(7.0, 3.0) != 7.0 { return 29; }

    if clamp_i32(0 - 5, 0, 10) != 0 { return 30; }
    if clamp_i32(15, 0, 10) != 10 { return 31; }
    if clamp_i32(5, 0, 10) != 5 { return 32; }
    if clamp_i32(0, 0, 10) != 0 { return 33; }
    if clamp_i32(10, 0, 10) != 10 { return 34; }
    if clamp_f64(0.0 - 5.0, 0.0, 10.0) != 0.0 { return 35; }
    if clamp_f64(15.0, 0.0, 10.0) != 10.0 { return 36; }
    if clamp_f64(5.5, 0.0, 10.0) != 5.5 { return 37; }

    return 0;
}
