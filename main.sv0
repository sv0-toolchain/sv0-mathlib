/* sv0-mathlib smoke/demo entry point.
 * Exit code convention: 0 = pass, nonzero = first failing case index.
 * Covers ARITH-001..004's i32, i64, and f64 forms — see lib/arith.sv0 and
 * BUGS.md for what's still blocked and why (abs_checked_i64, VM-backend
 * parity).
 */
use arith::abs_i32;
use arith::abs_checked_i32;
use arith::abs_checked_i64;
use arith::abs_i64;
use arith::abs_f64;
use prelude::Option;
use prelude::OptionI64;
use arith::sign_i32;
use arith::sign_i64;
use arith::sign_f64;
use arith::min_i32;
use arith::min_f64;
use arith::max_i32;
use arith::max_f64;
use arith::clamp_i32;
use arith::clamp_f64;
use arith::floor_f64;
use arith::ceil_f64;
use arith::trunc_f64;
use arith::round_f64;
use arith::is_nan_f64;
use arith::is_infinite_f64;
use arith::is_finite_f64;
use arith::lerp_f64;
use arith::pow_i64;
use arith::pow_checked_i64;
use arith::mul_checked_i64;
use modular::floor_mod_i64;
use modular::euclid_mod_i64;
use modular::gcd_u64;
use modular::gcd_checked_u64;
use modular::lcm_u64;
use modular::lcm_checked_u64;
use modular::add_mod_u64;
use modular::sub_mod_u64;
use modular::mul_mod_u64;
use prelude::OptionU64;

fn main() -> i32 {
    if abs_i32(5) != 5 { return 1; }
    if abs_i32(0 - 5) != 5 { return 2; }
    if abs_i32(0) != 0 { return 3; }
    if abs_f64(5.0) != 5.0 { return 4; }
    if abs_f64(0.0 - 5.0) != 5.0 { return 5; }
    if abs_f64(0.5) != 0.5 { return 6; }
    if abs_i64(5) != 5 { return 40; }
    if abs_i64(0 - 5) != 5 { return 41; }
    if abs_i64(9223372036854775807) != 9223372036854775807 { return 42; }
    if abs_i64(0 - 9223372036854775807) != 9223372036854775807 { return 43; }

    let some_case: Option = abs_checked_i32(0 - 5);
    let some_ok: bool = match some_case {
        Option::Some(v) => v == 5,
        Option::None => false,
    };
    if !some_ok { return 7; }
    let none_case: Option = abs_checked_i32(0 - 2147483648);
    let none_ok: bool = match none_case {
        Option::Some(v) => false,
        Option::None => true,
    };
    if !none_ok { return 8; }

    let some_case_i64: OptionI64 = abs_checked_i64(0 - 9223372036854775807);
    let some_ok_i64: bool = match some_case_i64 {
        OptionI64::Some(v) => v == 9223372036854775807,
        OptionI64::None => false,
    };
    if !some_ok_i64 { return 50; }
    let none_case_i64: OptionI64 = abs_checked_i64(0 - 9223372036854775807 - 1);
    let none_ok_i64: bool = match none_case_i64 {
        OptionI64::Some(v) => false,
        OptionI64::None => true,
    };
    if !none_ok_i64 { return 51; }

    if sign_i32(5) != 1 { return 10; }
    if sign_i32(0 - 5) != (0 - 1) { return 11; }
    if sign_i32(0) != 0 { return 12; }
    if sign_i64(5) != 1 { return 44; }
    if sign_i64(0 - 5) != (0 - 1) { return 45; }
    if sign_i64(0) != 0 { return 46; }
    if sign_f64(5.0) != 1.0 { return 13; }
    if sign_f64(0.0 - 5.0) != (0.0 - 1.0) { return 14; }
    if sign_f64(0.0) != 0.0 { return 15; }
    /* Previously written as `sign_f64(0.0 / 0.0)` (expression passed inline
     * to a call) to dodge BUGS.md #7 — that's fixed now, so this exercises
     * the actual pattern that used to break: an explicit annotated `let`
     * over a non-call/struct/enum RHS. */
    let nan: f64 = 0.0 / 0.0;
    if sign_f64(nan) != 0.0 { return 16; }

    if min_i32(3, 7) != 3 { return 20; }
    if min_i32(7, 3) != 3 { return 21; }
    if min_i32(4, 4) != 4 { return 22; }
    if max_i32(3, 7) != 7 { return 23; }
    if max_i32(7, 3) != 7 { return 24; }
    if max_i32(4, 4) != 4 { return 25; }
    if min_f64(3.0, 7.0) != 3.0 { return 26; }
    if min_f64(7.0, 3.0) != 3.0 { return 27; }
    if max_f64(3.0, 7.0) != 7.0 { return 28; }
    if max_f64(7.0, 3.0) != 7.0 { return 29; }

    if clamp_i32(0 - 5, 0, 10) != 0 { return 30; }
    if clamp_i32(15, 0, 10) != 10 { return 31; }
    if clamp_i32(5, 0, 10) != 5 { return 32; }
    if clamp_i32(0, 0, 10) != 0 { return 33; }
    if clamp_i32(10, 0, 10) != 10 { return 34; }
    if clamp_f64(0.0 - 5.0, 0.0, 10.0) != 0.0 { return 35; }
    if clamp_f64(15.0, 0.0, 10.0) != 10.0 { return 36; }
    if clamp_f64(5.5, 0.0, 10.0) != 5.5 { return 37; }

    if trunc_f64(3.7) != 3.0 { return 60; }
    if trunc_f64(0.0 - 3.7) != (0.0 - 3.0) { return 61; }
    if trunc_f64(3.0) != 3.0 { return 62; }
    if trunc_f64(0.0) != 0.0 { return 63; }
    if floor_f64(3.7) != 3.0 { return 64; }
    if floor_f64(0.0 - 3.7) != (0.0 - 4.0) { return 65; }
    if floor_f64(3.0) != 3.0 { return 66; }
    if ceil_f64(3.2) != 4.0 { return 67; }
    if ceil_f64(0.0 - 3.2) != (0.0 - 3.0) { return 68; }
    if ceil_f64(3.0) != 3.0 { return 69; }
    if round_f64(2.5) != 3.0 { return 70; }
    if round_f64(0.0 - 2.5) != (0.0 - 3.0) { return 71; }
    if round_f64(0.5) != 1.0 { return 72; }
    if round_f64(0.0 - 0.5) != (0.0 - 1.0) { return 73; }
    if round_f64(2.4) != 2.0 { return 74; }
    if round_f64(2.6) != 3.0 { return 75; }
    let big: f64 = 12345678901234.0;
    if floor_f64(big) != big { return 76; }
    if ceil_f64(big) != big { return 77; }
    if trunc_f64(big) != big { return 78; }
    if round_f64(big) != big { return 79; }

    let nan: f64 = 0.0 / 0.0;
    let inf: f64 = 1.0 / 0.0;
    let ninf: f64 = 0.0 - 1.0 / 0.0;
    if !is_nan_f64(nan) { return 80; }
    if is_nan_f64(1.0) { return 81; }
    if !is_infinite_f64(inf) { return 82; }
    if !is_infinite_f64(ninf) { return 83; }
    if is_infinite_f64(1.0) { return 84; }
    if is_infinite_f64(nan) { return 85; }
    if !is_finite_f64(1.0) { return 86; }
    if is_finite_f64(inf) { return 87; }
    if is_finite_f64(nan) { return 88; }

    if lerp_f64(2.0, 10.0, 0.0) != 2.0 { return 90; }
    if lerp_f64(2.0, 10.0, 1.0) != 10.0 { return 91; }
    if lerp_f64(0.0, 10.0, 0.5) != 5.0 { return 92; }

    if floor_mod_i64(7, 3) != 1 { return 100; }
    if floor_mod_i64(0 - 7, 3) != 2 { return 101; }
    if floor_mod_i64(7, 3) != euclid_mod_i64(7, 3) { return 102; }
    if floor_mod_i64(0, 5) != 0 { return 103; }
    if floor_mod_i64(9, 3) != 0 { return 104; }

    if gcd_u64(48, 18) != 6 { return 105; }
    if gcd_u64(17, 5) != 1 { return 106; }
    if gcd_u64(7, 7) != 7 { return 107; }
    if gcd_u64(1, 9) != 1 { return 108; }
    if gcd_checked_u64(0, 5) != 5 { return 109; }
    if gcd_checked_u64(5, 0) != 5 { return 110; }
    if gcd_checked_u64(0, 0) != 0 { return 111; }
    if gcd_checked_u64(48, 18) != 6 { return 112; }

    if lcm_u64(4, 6) != 12 { return 113; }
    if lcm_u64(3, 5) != 15 { return 114; }
    let lcm_ok: bool = match lcm_checked_u64(4, 6) {
        OptionU64::Some(v) => v == 12,
        OptionU64::None => false,
    };
    if !lcm_ok { return 115; }
    let lcm_overflow_ok: bool = match lcm_checked_u64(18446744073709551557, 18446744073709551533) {
        OptionU64::Some(v) => false,
        OptionU64::None => true,
    };
    if !lcm_overflow_ok { return 116; }
    let lcm_zero_ok: bool = match lcm_checked_u64(0, 5) {
        OptionU64::Some(v) => false,
        OptionU64::None => true,
    };
    if !lcm_zero_ok { return 117; }

    if add_mod_u64(7, 6, 10) != 3 { return 118; }
    let umax: u64 = 18446744073709551615;
    if add_mod_u64(umax, umax, 10) != 0 { return 119; }
    if add_mod_u64(umax - 1, 1, umax) != 0 { return 120; }
    if sub_mod_u64(3, 7, 10) != 6 { return 121; }
    if sub_mod_u64(7, 3, 10) != 4 { return 122; }
    if mul_mod_u64(7, 6, 10) != 2 { return 123; }
    if mul_mod_u64(123456789, 987654321, 1000000007) != 259106859 { return 124; }
    let big_prime: u64 = 18446744073709551557;
    if mul_mod_u64(big_prime - 1, big_prime - 1, big_prime) != 1 { return 125; }

    if pow_i64(2, 10) != 1024 { return 130; }
    if pow_i64(3, 5) != 243 { return 131; }
    if pow_i64(0 - 2, 3) != (0 - 8) { return 132; }
    if pow_i64(5, 0) != 1 { return 133; }
    if pow_i64(0, 5) != 0 { return 134; }
    if pow_i64(1, 62) != 1 { return 135; }

    let mc_ok: bool = match mul_checked_i64(6, 7) { OptionI64::Some(v) => v == 42, OptionI64::None => false };
    if !mc_ok { return 136; }
    let mc_ov: bool = match mul_checked_i64(1000000000000, 1000000000000) { OptionI64::Some(v) => false, OptionI64::None => true };
    if !mc_ov { return 137; }

    let pc_ok: bool = match pow_checked_i64(2, 10) { OptionI64::Some(v) => v == 1024, OptionI64::None => false };
    if !pc_ok { return 138; }
    let pc_ov: bool = match pow_checked_i64(2, 63) { OptionI64::Some(v) => false, OptionI64::None => true };
    if !pc_ov { return 139; }
    let pc_ok2: bool = match pow_checked_i64(2, 62) { OptionI64::Some(v) => v == 4611686018427387904, OptionI64::None => false };
    if !pc_ok2 { return 140; }
    let pc_neg: bool = match pow_checked_i64(0 - 3, 5) { OptionI64::Some(v) => v == (0 - 243), OptionI64::None => false };
    if !pc_neg { return 141; }

    return 0;
}
