/* abs_checked_i32 (ARITH-001), held out of lib/arith.sv0 — see BUGS.md #3.
 * Verified correct via a single-file harness (not --project, which is what's
 * broken): see BUGS.md #3 for the exact repro. Reinstate alongside
 * prelude.sv0.blocked once `enum Foo<T>` works under `--project`.
 */
module arith;

use prelude::Option;

fn abs_checked_i32(x: i32) -> Option {
    if x == (0 - 2147483648) {
        return Option::None;
    }
    return Option::Some(abs_i32(x));
}
